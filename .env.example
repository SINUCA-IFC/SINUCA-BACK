MODE=DEVELOPMENT
DEBUG=True
SECRET_KEY=replace-with-a-random-secret
DATABASE_URL=sqlite:///db.sqlite3
FRONTEND_URL=http://localhost:5173
# Ative no deploy somente se o proxy sobrescrever X-Forwarded-Proto.
TRUST_PROXY_HTTPS=False

# Credenciais do backend, nunca enviar ao frontend.
# Também podem permanecer em .secrets/google.env no desenvolvimento.
# GOOGLE_CLIENT_ID=preencha-se-for-usar-este-arquivo
# GOOGLE_CLIENT_SECRET=preencha-se-for-usar-este-arquivo

# Localhost: mensagens aparecem apenas no terminal do Django.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=SINUCA <no-reply@localhost>

# Para envio real, use django.core.mail.backends.smtp.EmailBackend acima.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# Web Push: configure o par VAPID no ambiente; nunca publique a chave privada.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
