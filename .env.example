TRUST_PROXY_HTTPS=False

# Preserve as credenciais Google ja configuradas no painel.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
