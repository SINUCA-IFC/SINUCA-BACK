MODE=PRODUCTION
DEBUG=False
# Preserve os valores reais do banco e da chave secreta no painel do deploy.
SECRET_KEY=replace-with-a-random-secret
DATABASE_URL=postgres://postgres:1bec267effe642fcb1d827f88433d718@dokku-postgres-sinuca-banco:5432/sinuca_banco
